# Copy to .env and fill in. .env is gitignored.
#
# Modal credentials are NOT here — they live in ~/.modal.toml after you run
# `uv run modal token new`. Putting MODAL_TOKEN_ID/SECRET here (even empty)
# shadows the config file and breaks `modal run`.

# W&B (https://wandb.ai/settings)
WANDB_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens — read access)
HF_TOKEN=
