# Copy to .env and fill in. .env is gitignored.
#
# Modal credentials are NOT here — they live in ~/.modal.toml after you run
# `uv run modal token new`. Putting MODAL_TOKEN_ID/SECRET here (even empty)
# shadows the config file and breaks `modal run`.

# W&B (https://wandb.ai/settings)
WANDB_API_KEY=

# Hugging Face (https://huggingface.co/settings/tokens — read access)
HF_TOKEN=

# Kaggle credentials for DeepSportradar Basketball Instants Dataset (Stage 3 mAP eval).
# Sign up at https://www.kaggle.com, then Settings → API → "Create New Token" downloads
# kaggle.json containing both fields. Accept dataset terms once at
# https://www.kaggle.com/datasets/deepsportradar/basketball-instants-dataset before first run.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Roboflow API key for OwnProjects basketball-w2xcw (Stage 3 mAP eval, secondary).
# Get from https://app.roboflow.com/settings/api after signing up (free tier).
ROBOFLOW_API_KEY=
